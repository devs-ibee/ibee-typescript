{
  "name": "ibee-sdk",
  "version": "0.3.1",
  "description": "Official TypeScript/JavaScript SDK for the IBEE Solutions cloud API",
  "license": "MIT",
  "author": "IBEE Solutions <support@ibee.ai>",
  "homepage": "https://ibee.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devs-ibee/ibee-typescript.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ibee",
    "cloud",
    "sdk",
    "api",
    "vm",
    "object-storage"
  ],
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
